{
    "$schema": "https://turbo.build/schema.json",
    "globalEnv": ["BASE_URL"],
    "globalDependencies": [".env"],
    "tasks": {
        "build": {
            "outputs": ["dist/**"],
            "inputs": ["$TURBO_DEFAULT$", "schema.d.ts", ".env"],
            "dependsOn": ["@terrier/api#generate"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "dev": {
            "persistent": true,
            "cache": false,
            "dependsOn": ["@terrier/api#generate"]
        },
        "start": {
            "dependsOn": ["@terrier/api#generate"]
        },
        "@terrier/api#generate": {
            "cache": true,
            "outputs": ["schema.d.ts"]
        }
    }
}
